# Direct dependencies of the pipeline scripts. requirements.txt pins the
# full set for every supported Python; regenerate it with
#   uv pip compile requirements.in --universal --python-version 3.10 -o requirements.txt
# NumPy and SciPy stopped supporting Python 3.10 after 2.2.6 and 1.15.3,
# and those releases have no wheels for Python 3.14, so each gets one
# pin below 3.11 and one from 3.11 on.
numpy==2.2.6; python_version < "3.11"
numpy>=2.3.2; python_version >= "3.11"
scipy==1.15.3; python_version < "3.11"
scipy>=1.16.2; python_version >= "3.11"
pandas>=2.3.3,<3
plotly
